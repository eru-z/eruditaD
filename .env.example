ADMIN_USERNAME=eruadmin
ADMIN_PASSWORD=use_a_unique_password_manager_generated_value_of_20_plus_chars
ADMIN_SESSION_SECRET=use_a_separate_cryptographically_random_value_of_32_plus_characters
ADMIN_SESSION_TTL_MINUTES=30
CORS_ORIGIN=https://erudita.dev
PORTFOLIO_URL=https://erudita.dev
AI_API_KEY=
AI_MODEL=openrouter/free
MAX_MESSAGES_PER_VISITOR_PER_DAY=25
MAX_OUTPUT_TOKENS=450
MONTHLY_BUDGET_USD=5
AI_TIMEOUT_MS=30000
CHATBOT_DEV_MOCK_RESPONSES=false
DEV_MAX_MESSAGES_PER_VISITOR_PER_DAY=8
PORTFOLIO_DATA_DIR=.portfolio-data

# Contact form email delivery (use a Gmail App Password, never your normal password)
CONTACT_EMAIL_TO=eruditazilbearids@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
SMTP_FROM=your-gmail-address@gmail.com

# Recommended for durable production admin content and uploads
# Production defaults to requiring this database, so admin edits cannot be
# silently saved to an ephemeral hosting filesystem.
REQUIRE_DATABASE=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_BUCKET=portfolio-media
