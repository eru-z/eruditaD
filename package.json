{
    "name":  "erudita-portfolio",
    "private":  true,
    "version":  "1.0.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite",
                    "dev:full":  "node scripts/dev-full.mjs",
                    "dev:backend":  "node server/index.js",
                    "build":  "vite build",
                    "build:dev":  "vite build --mode development",
                    "preview":  "vite preview",
                    "start":  "node server/index.js",
                    "test:e2e":  "node --test --test-concurrency=1 tests/projects.e2e.test.mjs",
                    "test:ai":  "node --test tests/openrouter.test.mjs",
                    "test:chatbot":  "node --test --test-concurrency=1 tests/chatbot.e2e.test.mjs",
                    "test":  "npm run test:ai \u0026\u0026 npm run test:e2e \u0026\u0026 npm run test:chatbot \u0026\u0026 npm run test:serverless",
                    "lint":  "eslint .",
                    "check":  "npm run lint \u0026\u0026 npm test \u0026\u0026 npm run build \u0026\u0026 npm run test:browser",
                    "test:browser":  "node tests/browser.audit.mjs",
                    "migrate:supabase":  "node scripts/migrate-to-supabase.mjs",
                    "test:serverless":  "node --test --test-concurrency=1 tests/serverless.e2e.test.mjs tests/vercel-handler.test.mjs"
                },
    "dependencies":  {
                         "@supabase/supabase-js":  "^2.111.0",
                         "dotenv":  "^17.4.2",
                         "framer-motion":  "^11.3.0",
                         "lucide-react":  "^0.460.0",
                         "nodemailer":  "^9.0.3",
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1",
                         "react-router-dom":  "^7.11.0"
                     },
    "devDependencies":  {
                            "@eslint/js":  "^10.0.1",
                            "@playwright/test":  "^1.62.1",
                            "@vitejs/plugin-react":  "^6.0.5",
                            "autoprefixer":  "^10.4.20",
                            "eslint":  "^10.8.0",
                            "eslint-plugin-react-hooks":  "^7.1.1",
                            "eslint-plugin-react-refresh":  "^0.5.3",
                            "globals":  "^17.8.0",
                            "postcss":  "^8.4.47",
                            "tailwindcss":  "^3.4.13",
                            "vite":  "^8.2.0"
                        }
}